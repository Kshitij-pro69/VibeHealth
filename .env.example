# ==========================================
# VibeHealth Environment Configuration
# ==========================================

# Server Network & App Config
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database & Cache
# Local MongoDB connection or Atlas URI
MONGO_URI=mongodb://localhost:27017/vibehealth
# Redis connection URL (used for slot holds and BullMQ queues)
REDIS_URL=redis://localhost:6379

# Authentication & Security
# Secret key for signing JWTs (must be at least 32 characters in production)
JWT_SECRET=vibehealth_jwt_super_secret_dev_key_replace_in_prod_12345
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Google Calendar API (OAuth 2.0)
# Configure credentials in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Transactional Email (SMTP / Nodemailer)
# Gmail App Password, SendGrid, AWS SES, or Ethereal test credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="VibeHealth <no-reply@vibehealth.com>"
